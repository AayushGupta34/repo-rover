# Copy this file to .env and fill in real values. Never put real secrets in this file.

# LLM provider: any OpenAI-compatible endpoint (Gemini, Groq, Cerebras, OpenRouter, ...)
LLM_BASE_URL=https://your-provider.example.com/v1
LLM_MODEL=your-model-name
LLM_API_KEY=your-llm-api-key

# Neon connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional (meta_crew.py)
# META_INTEL_SOURCES=https://example.com/advisories,https://example.com/issues
# META_LOOP_INTERVAL_SECONDS=21600

# Optional: input budget used to size tool output, detector hits and agent summaries (default 6000)
# LLM_MAX_INPUT_TOKENS=6000

# Optional: smaller models to fall back to, in order, when LLM_MODEL keeps failing (comma-separated)
# LLM_FALLBACK_MODELS=llama-3.1-8b-instant
